datasource db { 
  provider = "sqlite" 
  url = env("DATABASE_URL") 
}

generator client { 
  provider = "prisma-client-js" 
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("candidate") // "candidate" or "employer"
  createdAt DateTime @default(now())
  resumes   Resume[]
  apps      Application[]
  posts     BlogPost[]
  testResults TestResult[]
  skillVerifications SkillVerification[]
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  job       String
  status    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  category    String?  // e.g., "Frontend", "Backend", "Database"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tests       Test[]
  verifications SkillVerification[]
}

model Test {
  id          String   @id @default(cuid())
  skillId     String
  title       String
  description String?
  type        String   // "coding", "mcq", "mixed"
  difficulty  String   // "beginner", "intermediate", "advanced"
  timeLimit   Int      // in minutes
  questions   String   // JSON string of questions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skill       Skill    @relation(fields: [skillId], references: [id])
  results     TestResult[]
}

model TestResult {
  id              String   @id @default(cuid())
  userId          String
  testId          String
  answers         String   // JSON string of user answers
  score           Int      // 0-100
  timeSpent       Int      // in seconds
  tabSwitches     Int      @default(0)
  isVerified      Boolean  @default(false)
  submittedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  test            Test     @relation(fields: [testId], references: [id])
  skillVerifications SkillVerification[]
}

model SkillVerification {
  id            String   @id @default(cuid())
  userId        String
  skillId       String
  testResultId  String?
  isVerified    Boolean  @default(false)
  score         Int?     // 0-100
  verifiedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
  skill         Skill    @relation(fields: [skillId], references: [id])
  testResult    TestResult? @relation(fields: [testResultId], references: [id])
}
